<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="shop.samdul.greeting.mapper.TodoMapper">
        <select id="findAll" resultType="shop.samdul.greeting.entity.TodoEntity">
                SELECT
                        id, subject, body, completed
                FROM ENCORE_TODO_TBL
                ORDER BY id DESC
        </select>
        
	<select id="findById" parameterType="int" resultType="shop.samdul.greeting.entity.TodoEntity">
                SELECT
                        id, subject, body, completed
                FROM ENCORE_TODO_TBL 
                WHERE id = #{id};
        </select>

         <insert id="insert" parameterType="shop.samdul.greeting.entity.TodoEntity">
                INSERT INTO todos (subject, body, completed) VALUES (#{subject}, #{body}, #{completed})
        </insert>

        <update id="update" parameterType="shop.samdul.greeting.entity.TodoEntity">
                UPDATE todos
                SET subject = #{subject}, body = #{body}, completed = #{completed}
                WHERE id = #{id}
        </update>

        <delete id="delete" parameterType="Integer">
                DELETE FROM todos WHERE id = #{id}
        </delete>
</mapper>